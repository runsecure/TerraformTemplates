#cloud-config
package_update: true
package_upgrade: true

packages:
  - apache2
  - ufw
%{ if enable_fail2ban ~}
  - fail2ban
%{ endif ~}
%{ if enable_unattended_upgrades ~}
  - unattended-upgrades
%{ endif ~}
%{ if length([for m in additional_mounts : m if m.type == "nfs"]) > 0 ~}
  - nfs-common
%{ endif ~}
%{ if length([for m in additional_mounts : m if m.type == "smb"]) > 0 ~}
  - cifs-utils
%{ endif ~}
%{ if length([for m in additional_mounts : m if m.type == "s3"]) > 0 ~}
  - s3fs
%{ endif ~}

write_files:
  - path: /etc/apache2/conf-available/harden.conf
    owner: root:root
    permissions: "0644"
    content: |
      ServerTokens Prod
      ServerSignature Off
      TraceEnable Off

runcmd:
  # Apache: minimal footprint, no version/banner disclosure.
  - a2enconf harden
  - systemctl enable apache2
  - systemctl restart apache2

  # SSH: no root login, no password auth (key-only). Ansible connects as
  # the admin_username account, whose key was provisioned via the
  # instance's ssh-keys metadata.
  - sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
  - sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config
  - sed -i 's/^#\?KbdInteractiveAuthentication.*/KbdInteractiveAuthentication no/' /etc/ssh/sshd_config
  - systemctl restart ssh

  # Host firewall: default-deny inbound, explicit allow for SSH/HTTP/HTTPS.
  # The VPC firewall rules are the primary boundary; this is
  # defense-in-depth at the host.
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 22/tcp
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw --force enable

%{ if enable_fail2ban ~}
  - systemctl enable --now fail2ban
%{ endif ~}
%{ if enable_unattended_upgrades ~}
  - dpkg-reconfigure -f noninteractive unattended-upgrades
  - systemctl enable --now unattended-upgrades
%{ endif ~}

  # Additional local data disks (data_disks variable): format (ext4) and
  # mount any attached block device that has no filesystem yet. Idempotent
  # - a disk with an existing filesystem is left alone on re-runs/reboots.
  - |
    n=0
    for disk in $(lsblk -ndp -o NAME,TYPE,FSTYPE | awk '$2=="disk" && $3==""{print $1}'); do
      mkfs.ext4 -F "$disk"
      mountpoint="/mnt/data$n"
      mkdir -p "$mountpoint"
      mount "$disk" "$mountpoint"
      echo "$disk $mountpoint ext4 defaults,nofail 0 2" >> /etc/fstab
      n=$((n+1))
    done

  # Additional network storage mounts (additional_mounts variable): NFS,
  # SMB/CIFS, or S3 (via s3fs). This does not create the storage, only
  # mounts it - the source must already exist.
%{ for m in additional_mounts ~}
  - mkdir -p ${m.mount_point}
%{ if m.type == "nfs" ~}
  - mount -t nfs4 ${m.options != "" ? "-o ${m.options} " : ""}${m.source} ${m.mount_point}
  - echo "${m.source} ${m.mount_point} nfs4 ${m.options != "" ? m.options : "defaults,_netdev"} 0 0" >> /etc/fstab
%{ endif ~}
%{ if m.type == "smb" ~}
  - mount -t cifs ${m.source} ${m.mount_point} -o ${m.options != "" ? m.options : "guest,vers=3.0,_netdev"}
%{ endif ~}
%{ if m.type == "s3" ~}
  - s3fs ${m.source} ${m.mount_point} -o ${m.options != "" ? m.options : "iam_role=auto,allow_other,_netdev"}
%{ endif ~}
%{ endfor ~}
